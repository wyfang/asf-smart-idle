<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SmartIdle.HostProbe</AssemblyName>
    <RootNamespace>SmartIdle.HostProbe</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SmartIdle.Core/SmartIdle.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="ArchiSteamFarm" HintPath="$(AsfReferenceDir)/ArchiSteamFarm.dll" Private="false" />
    <Reference Include="System.Composition.AttributedModel" HintPath="$(AsfReferenceDir)/System.Composition.AttributedModel.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckAsfReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AsfReferenceDir)/ArchiSteamFarm.dll')" Text="Run scripts/prepare-asf.sh and set ASF_REFERENCE_DIR or AsfReferenceDir." />
  </Target>
</Project>
